        <mxCell id="O-bFJzmXxWYWXPy9jXqx-109" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 18px;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Chú thích:&lt;/font&gt;&lt;/h1&gt;&lt;p style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;font-size: 18px;&quot;&gt;SCM:&lt;/b&gt; Supply Chain Management (Quản lý chuỗi cung ứng)&lt;/p&gt;&lt;p style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;font-size: 18px;&quot;&gt;Định tuyến:&lt;/b&gt; xác định quá trình và trình tự các hoạt động mà một sản phẩm hoặc vật liệu phải trải qua trong quá trình sản xuất hoặc di chuyển qua các kho&lt;/p&gt;&lt;p style=&quot;font-size: 18px;&quot;&gt;&lt;span style=&quot;background-color: initial; text-align: center; font-size: 18px;&quot;&gt;&lt;b style=&quot;font-size: 18px;&quot;&gt;Chatter:&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-size: 18px;&quot;&gt;Đây là một công cụ giao tiếp cho phép người dùng để&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-size: 18px;&quot;&gt;Ghi lại trao đổi nội bộ,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-size: 18px;&quot;&gt;Gửi thông báo và email.&lt;/span&gt;&lt;br style=&quot;font-size: 18px;&quot;&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=18;" vertex="1" parent="tHNSZZsKx9AplI9Phplz-1">
